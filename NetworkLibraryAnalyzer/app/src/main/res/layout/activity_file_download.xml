<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="50dp"
            android:text="Download Files"
            android:textColor="#172033"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Choose 1 to 10 files from the server to test download speed"
            android:textColor="#737B8C"
            android:textSize="14sp" />

        <!-- SERVER FILES HEADING + COUNT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Files on Server"
                android:textColor="#172033"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 selected"
                android:textColor="#3157D5"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SERVER FILES CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/filesStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap the button to load the file list"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <!-- Check boxes are added here from Java -->
                <LinearLayout
                    android:id="@+id/serverFilesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshFilesButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Load files from server"
                    android:textAllCaps="false"
                    android:textColor="#3157D5"
                    android:textSize="14sp"
                    app:backgroundTint="#E7EDFF"
                    app:cornerRadius="12dp"
                    app:strokeColor="#B8CCFF"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- NETWORK LIBRARY HEADING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Network Library Selection"
            android:textColor="#172033"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- NETWORK LIBRARY CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/libraryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select One or More Libraries"
                    android:textColor="#172033"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/httpURLConnectionCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="HttpURLConnection"
                        android:textColor="#172033"
                        android:textSize="15sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/okHttpCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="OkHttp"
                        android:textColor="#172033"
                        android:textSize="15sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/retrofitCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Retrofit"
                        android:textColor="#172033"
                        android:textSize="15sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/volleyCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Volley"
                        android:textColor="#172033"
                        android:textSize="15sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/ktorCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Ktor"
                        android:textColor="#172033"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CHOOSE LIBRARY BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chooseLibraryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Choose Network Library"
            android:textAllCaps="false"
            android:textColor="#3157D5"
            android:textSize="15sp"
            app:backgroundTint="#E7EDFF"
            app:cornerRadius="12dp"
            app:strokeColor="#B8CCFF"
            app:strokeWidth="1dp" />

        <!-- DOWNLOAD INFORMATION HEADING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Downloading Information"
            android:textColor="#172033"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- DOWNLOAD INFORMATION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of Files"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/infoFileCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Files"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/infoFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="No file selected"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Total Size"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/infoFileSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--"
                    android:textColor="#172033"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Selected Libraries"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/infoLibraries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="No library selected"
                    android:textColor="#172033"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Download Status"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/infoDownloadStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Load the file list first"
                    android:textColor="#3157D5"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DOWNLOAD PERFORMANCE HEADING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Downloading Performance"
            android:textColor="#172033"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- DOWNLOAD PERFORMANCE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download Time (all files)"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/performanceDownloadTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not tested"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Throughput"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/performanceThroughput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not tested"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Response Time"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/performanceResponseTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not tested"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Success Rate"
                    android:textColor="#737B8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/performanceSuccessRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not tested"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SUCCESS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/successCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#A5D6A7"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Success icon"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#2E7D32" />

                <TextView
                    android:id="@+id/successMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Download completed!"
                    android:textColor="#2E7D32"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- START DOWNLOAD BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadFile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:enabled="false"
            android:text="Start Download Analysis Test"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#3157D5"
            app:cornerRadius="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>